# Backend
# "development" (default) is permissive for local work. Set to "production"
# to enable strict startup checks (see below) — the app refuses to start in
# production with a placeholder JWT_SECRET, a wildcard CORS origin, a
# non-HTTPS FRONTEND_BASE_URL, or a MONGO_URI containing a dev password.
ENVIRONMENT=development

# Must be at least 16 characters always, 32+ and a real random value (not a
# placeholder) once ENVIRONMENT=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_this_to_a_long_random_string
FREE_TIER_UPLOAD_LIMIT=3

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_this_password
MONGO_URI=mongodb://admin:change_this_password@mongo:27017/lexassist?authSource=admin

# AI provider (LLM analiz / sohbet için) — Google Gemini
# Ücretsiz anahtar: https://aistudio.google.com/apikey adresinden Google
# hesabınızla giriş yapıp "Create API key" ile alabilirsiniz (ücretsiz kota içerir).
GEMINI_API_KEY=

# Şifre sıfırlama / e-posta doğrulama bağlantıları bu adres üzerinden kurulur
FRONTEND_BASE_URL=http://localhost:3000

# =============================================================================
# E-POSTA (şifre sıfırlama + e-posta doğrulama)
# =============================================================================
# EMAIL_MODE:
#   auto    -> SMTP_HOST doluysa gerçek e-posta gönderir, boşsa konsola yazar (varsayılan)
#   console -> her zaman backend loguna yazar (geliştirme; production'da yasak)
#   smtp    -> her zaman SMTP ile gönderir
EMAIL_MODE=auto

# --- Gmail örneği ---
# 1) Google hesabınızda 2 Adımlı Doğrulama'yı açın.
# 2) https://myaccount.google.com/apppasswords adresinden bir "Uygulama Şifresi" oluşturun
#    (normal Google şifreniz DEĞİL — 16 haneli uygulama şifresi).
# 3) Aşağıyı doldurun:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=hesabiniz@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx     # oluşturulan uygulama şifresi
# SMTP_FROM=hesabiniz@gmail.com          # Gmail, From adresinin SMTP_USER ile eşleşmesini ister
# SMTP_FROM_NAME=LexAssist AI
# SMTP_USE_TLS=true                       # STARTTLS (port 587)
# SMTP_USE_SSL=false                      # implicit SSL için port 465 + bunu true yapın, USE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@lexassist.ai
SMTP_FROM_NAME=LexAssist AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
